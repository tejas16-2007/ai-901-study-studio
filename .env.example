# =============================================================================
# AI-901 Study Studio — Dual-Mode Environment Configuration
# =============================================================================
# Leave values blank (or omit .env) to run immediately in Local Demo/Mock Mode.
# Populate your Microsoft Foundry / Azure AI credentials below to switch
# individual workloads (or all workloads) into Live Microsoft Foundry Mode.

# Mode override: "auto" (default - uses Live when credentials are present),
# "mock" (always use local demo simulator), or "live" (require live Azure creds)
AI901_MODE=auto

# -----------------------------------------------------------------------------
# 1. Microsoft Foundry Project & Generative AI / Agents
#    Docs: https://learn.microsoft.com/en-us/azure/ai-foundry/
# -----------------------------------------------------------------------------
# Foundry Project endpoint (used with azure-ai-projects & DefaultAzureCredential)
AZURE_AI_PROJECT_ENDPOINT=

# Azure OpenAI / Foundry Model Inference endpoint & key
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o-mini

# Optional: existing Foundry Agent ID created in the Microsoft Foundry portal
AZURE_AI_AGENT_ID=

# -----------------------------------------------------------------------------
# 2. Azure Language (Text Analysis in Foundry Tools)
# -----------------------------------------------------------------------------
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=

# -----------------------------------------------------------------------------
# 3. Azure Speech (Speech-to-Text / Text-to-Speech in Foundry Tools)
# -----------------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus

# -----------------------------------------------------------------------------
# 4. Azure Content Understanding (Information Extraction in Foundry Tools)
# -----------------------------------------------------------------------------
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=
AZURE_CONTENT_UNDERSTANDING_KEY=
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-05-01-preview

# Server configuration
HOST=0.0.0.0
PORT=8000
